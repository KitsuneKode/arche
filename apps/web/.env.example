# Frontend environment (Arche template site — apps/web)
# Copy to .env.local for local development.
# Production (Vercel arche): see docs/deployment-vercel-arche.md

NEXT_PUBLIC_SITE_NAME=Arche
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_DESCRIPTION=Full-stack TypeScript monorepo template — auth, database, API, and frontend wired and ready.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Same-origin API proxy (production Vercel + external API host):
# Set NEXT_PUBLIC_API_URL to the same value as NEXT_PUBLIC_APP_URL, then set API_UPSTREAM_URL
# on the Vercel web project only (not NEXT_PUBLIC) to your real API host.
# API_UPSTREAM_URL=https://api.example.com
