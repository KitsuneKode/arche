# Backend environment configuration
# This file documents all backend environment variables
# Copy to .env for local development and customize as needed

# Core Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
# RENDER=true is set automatically on Render (stdout logging, no log files)

# PostgreSQL — match your local Docker compose (user/password + arche_dev)
DATABASE_URL=postgresql://user:password@localhost:5432/arche_dev

# Example from apps/server/.env.example (different credentials):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_app

# Alternative: SQLite (good for local development)
# DATABASE_URL=file:./dev.db

# Alternative: MongoDB
# DATABASE_URL=mongodb://mongo:mongo@localhost:27017/my_app?authSource=admin

# Frontend Reference
FRONTEND_URL=http://localhost:3000

# Cache / queues — false for local web + API (Relay Run, auth, leaderboard). No Redis container needed.
ENABLE_REDIS=false
# Optional queues/worker: set true and run Redis compose (see docs/env.md).
# ENABLE_REDIS=true
# REDIS_URL=redis://localhost:6379

# Authentication (Better Auth)
# Generate a secure random string (at least 32 characters) for production
# openssl rand -base64 32  (never commit the real value)
BETTER_AUTH_SECRET=local-dev-only-not-a-real-better-auth-secret
BETTER_AUTH_URL=http://localhost:8080

# Marketing demo (/live): auto sign-in after email sign-up. Required on production API for proof-run write rungs.
DEMO_AUTO_SIGN_IN=true

# Optional: OAuth Providers
# Configure only if you want to enable social authentication
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Relay Lattice: background round engine (resolve clashes, post system chat).
# Default on Render/Docker/local. Set false on Vercel API when Render also runs the engine.
#LATTICE_ROUND_ENGINE=false
