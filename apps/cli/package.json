{
  "name": "@kitsunekode/arche",
  "version": "0.2.0",
  "description": "Arche — scaffold personal project vaults, TypeScript monorepos, Rust services, and Solana app foundations",
  "keywords": [
    "better-auth",
    "boilerplate",
    "cli",
    "express",
    "fullstack",
    "monorepo",
    "nextjs",
    "prisma",
    "rust",
    "scaffold",
    "solana",
    "starter",
    "template",
    "trpc",
    "turborepo",
    "typescript"
  ],
  "homepage": "https://arche.kitsunelabs.xyz",
  "bugs": {
    "url": "https://github.com/kitsunekode/arche/issues"
  },
  "license": "MIT",
  "author": "kitsunekode <bhuyanmanash2002@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitsunekode/arche.git",
    "directory": "apps/cli"
  },
  "bin": {
    "arche": "dist/index.js",
    "create-arche": "dist/index.js"
  },
  "files": [
    "dist",
    "src/templates",
    "assets/icon.png",
    "README.md",
    "CHANGELOG.md",
    "CLI-SPEC.md"
  ],
  "type": "module",
  "exports": {
    "./create": "./src/lib/create.ts",
    "./generated-project-verifier": "./src/lib/generated-project-verifier.ts",
    "./schemas": "./src/types/schemas.ts",
    "./preset-config": "./src/registry/preset-config.ts",
    "./capabilities/apply": "./src/lib/capabilities/apply-capabilities.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outfile ./dist/index.js --target node --minify",
    "build:dev": "bun build ./src/index.ts --outfile ./dist/index.js --target node",
    "dev": "bun run ./src/index.ts",
    "link": "bun run build && bun link",
    "unlink": "bun unlink",
    "test": "bun test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check-types": "tsc --noEmit",
    "pack:dry-run": "bun run build && npm pack --dry-run",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@arche-template/registry": "workspace:*",
    "@clack/prompts": "^1.4.0",
    "picocolors": "^1.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arche-template/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
