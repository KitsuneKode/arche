{
  "name": "arche-template",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "toolings/*",
      "tests/*"
    ],
    "catalog": {
      "@bull-board/api": "^7.1.5",
      "@bull-board/express": "^7.1.5",
      "@hugeicons/core-free-icons": "^4.1.4",
      "@hugeicons/react": "^1.1.9",
      "@prisma/adapter-pg": "^7.8.0",
      "@prisma/client": "^7.8.0",
      "@t3-oss/env-core": "^0.13.11",
      "@t3-oss/env-nextjs": "^0.13.11",
      "@tailwindcss/postcss": "^4.3.1",
      "@tanstack/react-query": "^5.101.1",
      "@trpc/client": "^11.18.0",
      "@trpc/server": "^11.18.0",
      "@trpc/tanstack-react-query": "^11.18.0",
      "@turbo/gen": "^2.10.0",
      "@types/bun": "1.3.14",
      "@types/compression": "^1.7.5",
      "@types/cors": "^2.8.19",
      "@types/express": "^5.0.6",
      "@types/mdx": "^2.0.14",
      "@types/node": "^25.9.0",
      "@types/pg": "^8.20.0",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "better-auth": "1.6.11",
      "bullmq": "^5.79.1",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "compression": "^1.8.1",
      "cors": "^2.8.6",
      "date-fns": "^4.4.0",
      "express": "^5.2.1",
      "express-rate-limit": "^8.5.2",
      "fumadocs-core": "^16.10.5",
      "fumadocs-mdx": "^15.0.12",
      "ioredis": "5.10.1",
      "mermaid": "^11.15.0",
      "motion": "^12.41.0",
      "next": "^16.2.9",
      "next-themes": "^0.4.6",
      "oxfmt": "^0.50.0",
      "oxlint": "^1.71.0",
      "pg": "^8.22.0",
      "prisma": "^7.8.0",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "redis": "^5.12.1",
      "shadcn": "^4.11.0",
      "shiki": "^4.2.0",
      "sonner": "^2.0.7",
      "sugar-high": "^1.2.1",
      "superjson": "^2.2.6",
      "tailwind-merge": "^3.6.0",
      "tailwindcss": "^4.3.1",
      "turbo": "^2.10.0",
      "typescript": "^6.0.3",
      "winston": "^3.19.0",
      "zod": "^4.4.3"
    }
  },
  "scripts": {
    "agents:sync": "bun toolings/scripts/sync-template-agents.ts",
    "agents:sync:check": "bun toolings/scripts/sync-template-agents.ts --check",
    "template:extract": "bun toolings/scripts/extract-fullstack-template.ts",
    "template:extract:check": "bun toolings/scripts/extract-fullstack-template.ts --check",
    "template:sync:check": "bun toolings/scripts/sync-fullstack-template.ts --check",
    "web-core:sync": "bun toolings/scripts/sync-web-core.ts",
    "web-core:sync:check": "bun toolings/scripts/sync-web-core.ts --check",
    "build": "turbo run build",
    "build:affected": "turbo run build --affected",
    "build:docs": "turbo run build --filter=@arche-template/web",
    "brand:export-og": "bun toolings/scripts/export-og-image.ts",
    "build:vercel": "turbo run build:vercel",
    "brand:export": "bun toolings/scripts/export-brand-assets.ts",
    "catalog:apply": "bun toolings/scripts/apply-workspace-catalog.ts",
    "deps:audit": "bun toolings/scripts/audit-dependencies.ts",
    "deps:unused": "bun toolings/scripts/audit-unused-dependencies.ts",
    "template-deps:check": "bun toolings/scripts/audit-template-deps.ts",
    "ci": "bun run format:check && bunx turbo run lint check-types && bun test && bunx turbo run build && bun run pkg:check && bun run repo:doctor:strict",
    "ci:affected": "bun run format:check && bunx turbo run lint check-types --affected && bun test && bunx turbo run build --affected && bun run pkg:check && bun run repo:doctor:strict",
    "ci:min": "bun run format:check && bunx turbo run lint check-types && bun test && bunx turbo run build",
    "ci:full": "bun run ci && bun toolings/scripts/verify-generated-project.ts --combo-matrix --run=install,typecheck,lint,build",
    "check:cli": "bun run format:check && bunx turbo run lint check-types --filter=@kitsunekode/arche && bun test apps/cli/tests",
    "check:web": "bun run format:check && bunx turbo run lint check-types --filter=@arche-template/web && bun test apps/web",
    "secret-scan": "gitleaks detect --source . --redact=100 --config .gitleaks.toml",
    "secret-scan:staged": "gitleaks protect --staged --redact --config .gitleaks.toml",
    "dev": "turbo run dev",
    "dev:app": "turbo run dev --filter=@arche-template/web --filter=@arche-template/server",
    "dev:deps": "bun toolings/scripts/dev-deps.ts",
    "dev:deps:redis": "bun toolings/scripts/dev-deps.ts --redis",
    "dev:deps:down": "bun toolings/scripts/dev-deps.ts --down",
    "dev:local": "bun run dev:deps && bun run db:migrate && bun run dev:app",
    "dev:cli": "turbo run dev --filter=@kitsunekode/arche --",
    "build:cli": "turbo run build --filter=@kitsunekode/arche",
    "pkg:check": "bun run --cwd apps/cli pack:dry-run",
    "changeset": "bun run --filter @arche-template/dev changeset",
    "changeset:status": "bun run --filter @arche-template/dev changeset:status",
    "version:packages": "bun run --filter @arche-template/dev changeset:version",
    "release": "bun toolings/scripts/release-guard.ts",
    "release:publish": "bun run --filter @arche-template/dev changeset:publish",
    "repo:doctor": "bun toolings/scripts/repo-doctor.ts",
    "repo:doctor:strict": "bun toolings/scripts/repo-doctor.ts --strict",
    "verify:generated": "bun toolings/scripts/verify-generated-project.ts",
    "verify:generated:fullstack": "bun toolings/scripts/verify-generated-project.ts --preset=typescript-fullstack --pm=bun --run=install,typecheck,build",
    "verify:generated:live-demo": "bun toolings/scripts/verify-generated-project.ts --preset=typescript-fullstack --pm=bun --config-json='{\"includeLiveDemo\":true,\"includeWorker\":true}' --run=install,typecheck",
    "verify:generated:combo-fullstack": "bun toolings/scripts/verify-generated-project.ts --combo-matrix --combo-family=fullstack --run=install,typecheck,lint,build",
    "smoke:scaffold": "bun toolings/scripts/smoke-scaffold-manual.ts",
    "template:clean:dry": "bun toolings/scripts/template-cleanup.ts --dry-run",
    "template:clean": "bun toolings/scripts/template-cleanup.ts --yes",
    "commit:check": "commitlint --last --verbose",
    "lint": "turbo run lint",
    "lint:affected": "turbo run lint --affected",
    "lint:fix": "turbo run lint:fix",
    "clean": "find . -name node_modules -o -name .next -o -name .turbo -o -name dist -type d -prune | xargs rm -rf",
    "check-types": "turbo run check-types",
    "check-types:affected": "turbo run check-types --affected",
    "test": "bun test --path-ignore-patterns 'apps/cli/src/templates/**'",
    "dev:web": "turbo run dev --filter=@arche-template/web",
    "dev:server": "turbo run dev --filter=@arche-template/server",
    "dev:worker": "turbo run dev --filter=@arche-template/worker",
    "db:seed": "turbo run db:seed",
    "db:studio": "turbo run db:studio",
    "db:generate": "turbo run db:generate",
    "format": "bun run --filter @arche-template/dev format",
    "format:check": "bun run --filter @arche-template/dev format:check",
    "db:migrate": "turbo run db:migrate",
    "db:deploy": "turbo run db:deploy --filter=@arche-template/store",
    "rename-scope": "bun toolings/scripts/rename-scope.ts",
    "rename-scope:dry": "bun toolings/scripts/rename-scope.ts --dry-run",
    "rename-scope:verbose": "bun toolings/scripts/rename-scope.ts --verbose",
    "preinstall": "bunx only-allow bun",
    "postinstall": "bun toolings/scripts/postinstall-generate.ts",
    "docker:build": "docker build -f apps/server/Dockerfile -t arche-server .",
    "docker:run": "docker run --rm -p 8080:8080 -e ENABLE_REDIS=false arche-server",
    "test:deploy": "RUN_DEPLOY_SMOKE=1 bun test tests/src/integration/deploy-smoke.test.ts",
    "test:deploy:all": "RUN_DEPLOY_SMOKE=1 RENDER_API_URL=https://arche-template-api.onrender.com VERCEL_API_URL=https://arche-api-kitsunekode.vercel.app bun test tests/src/integration/deploy-smoke.test.ts",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "only-allow": "^1.2.2",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14"
}
